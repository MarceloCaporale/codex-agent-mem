include README.md
include README_ES.md
include README_DE.md
include README_JA.md
include README_PT_BR.md
include README_ZH.md
include LICENSE
include NOTICE
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include AGENTS.md
include RELEASE_NOTES_v1.0.1.md
recursive-include src/codex_agent_mem *.sql
recursive-include src/codex_agent_mem/templates *.html
recursive-include src/codex_agent_mem/static *.css
