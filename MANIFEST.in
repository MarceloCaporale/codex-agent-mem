prune docs/verification/v1.0.0/export_public
prune docs/verification/v1.0.1/runs
prune docs/verification/v1.0.1/export_public
global-exclude *.py[cod]
global-exclude __pycache__/*
global-exclude .pytest_cache/*
global-exclude .ruff_cache/*
