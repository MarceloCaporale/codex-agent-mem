# Example for ~/.codex/config.toml
# Use single-quoted TOML strings on Windows so backslashes stay literal.
# Replace the paths with your real install paths.

notify = [
  'C:\Path\To\python.exe',
  '-m',
  'codex_agent_mem.codex_notify',
  '--project-from-cwd',
  '--db-path',
  'C:\Users\YOU\.codex_agent_mem\codex_agent_mem.db'
]
# Add '--sync-project-doc' before '--db-path' if you want automatic AGENTS.md reinjection.

[mcp_servers."codex-agent-mem"]
command = 'C:\Path\To\python.exe'
args = [
  '-m',
  'codex_agent_mem.mcp_stdio',
  '--idle-timeout-seconds',
  '300',
  '--profile',
  'minimal',
  '--response-mode',
  'compact',
  '--read-only',
  '--db-path',
  'C:\Users\YOU\.codex_agent_mem\codex_agent_mem.db'
]

[mcp_servers."codex-agent-mem".tools.mem_open_work]
approval_mode = "approve"

[mcp_servers."codex-agent-mem".tools.mem_completion_check]
approval_mode = "approve"

[mcp_servers."codex-agent-mem".tools.mem_recent_changes]
approval_mode = "approve"

[mcp_servers."codex-agent-mem".tools.mem_scope_guard]
approval_mode = "approve"

[mcp_servers."codex-agent-mem".tools.mem_context_pack]
approval_mode = "approve"

[mcp_servers."codex-agent-mem".tools.mem_provenance]
approval_mode = "approve"

[mcp_servers."codex-agent-mem".tools.mem_health]
approval_mode = "approve"

[mcp_servers."codex-agent-mem".tools.mem_health_runtime]
approval_mode = "approve"
